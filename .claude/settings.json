{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go run ./cmd/svm *)",
      "Bash(go mod tidy *)",
      "Bash(go mod verify)",
      "Bash(go mod download *)",
      "Bash(go list *)",
      "Bash(go doc *)",
      "Bash(go env *)",
      "Bash(go version)",
      "Bash(go tool cover *)",
      "Bash(golangci-lint run *)",
      "Bash(golangci-lint fmt *)",
      "Bash(golangci-lint version)",
      "Bash(goreleaser check *)",
      "Bash(goreleaser release --snapshot *)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make tidy)",
      "Bash(make check)",
      "Bash(make snapshot)",
      "Bash(make clean)",
      "Bash(make help)",
      "Bash(./bin/svm *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore --staged *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(gh release *)",
      "Bash(go get *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_response.filePath // .tool_input.file_path // empty\" | { read -r f; case \"$f\" in *.go) [ -f \"$f\" ] && cd \"$CLAUDE_PROJECT_DIR\" && golangci-lint fmt \"$f\" ;; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting Go file"
          }
        ]
      }
    ]
  }
}